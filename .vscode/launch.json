{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Local",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": false
    },
    {
      "name": "Backend: Attach Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "/app"
        }
      ]
    },
    {
      "name": "Frontend: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend: Attach Docker",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "webRoot": "${workspaceFolder}/frontend",
      "restart": true,
      "localRoot": "${workspaceFolder}/frontend",
      "remoteRoot": "/app"
    }
  ]
}